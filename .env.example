# --- Bayse (https://app.bayse.markets/settings/api-keys) ---
BAYSE_PUBLIC_KEY=pk_live_xxx
BAYSE_SECRET_KEY=sk_live_xxx

# --- Claude (research) ---
ANTHROPIC_API_KEY=sk-ant-xxx
RESEARCH_MODEL=claude-opus-5
TRIAGE_MODEL=claude-opus-5

# --- Telegram (create a bot with @BotFather; get your chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=123456:abc
TELEGRAM_CHAT_ID=123456789
# polling for local, webhook for Cloud Run
TELEGRAM_MODE=polling
# random string; Telegram echoes it back so we can verify webhook calls
TELEGRAM_WEBHOOK_SECRET=change-me
# public base URL of the deployed service (webhook mode only)
PUBLIC_URL=

# --- Runtime ---
# local = run scans/ticks on an in-process timer; cloud = wait for Cloud Scheduler to hit /jobs/*
RUN_MODE=local
PORT=8080
# shared secret Cloud Scheduler sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me
# libSQL: a local file, or a Turso URL (libsql://...) in the cloud
DATABASE_URL=file:clover.db
DATABASE_AUTH_TOKEN=

# --- Money ---
# true = paper trading: everything runs, but no real orders are sent
DRY_RUN=true
CAPITAL_NGN=10000
# fraction of full Kelly to bet (0.25 = quarter Kelly)
KELLY_FRACTION=0.25
# hard cap on a single bet as a fraction of capital
MAX_BET_FRACTION=0.1
# minimum expected return after fees and price impact (0.05 = +5%)
MIN_EDGE=0.05
# minutes you have to cancel a bet before it is placed
CANCEL_WINDOW_MINUTES=30
MAX_SLIPPAGE=0.02

# --- Scanning ---
SCAN_INTERVAL_MINUTES=120
TICK_INTERVAL_MINUTES=1
MAX_DEEP_DIVES_PER_SCAN=8
RESEARCH_COOLDOWN_HOURS=24
MIN_HOURS_TO_CLOSE=2
MAX_DAYS_TO_CLOSE=60
