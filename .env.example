# Secrets only. Every other setting lives in src/settings.ts.
# On Cloud Run these come from GitHub secrets via the deploy workflow.

# app.bayse.markets → Settings → API Keys
BAYSE_PUBLIC_KEY=pk_live_xxx
BAYSE_SECRET_KEY=sk_live_xxx

# aistudio.google.com/apikey
GEMINI_API_KEY=

# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# your own chat id: message @userinfobot
TELEGRAM_CHAT_ID=

# random string, e.g. `openssl rand -hex 32`
APP_SECRET=
